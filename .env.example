# Development only. Generate a strong unique production value.
# Quote values containing spaces or `#`; the application safely URL-encodes
# database credentials rather than interpolating them into a connection URL.
POSTGRES_DB=mitra
POSTGRES_USER=mitra
POSTGRES_PASSWORD="change-me-before-use"
MITRA_ENVIRONMENT=development
MITRA_LOG_LEVEL=INFO
MITRA_API_PORT=8000
